# Domain tanpa https:// dan tanpa garis miring di akhir.
DOMAIN=suratapp.example.com

POSTGRES_DB=suratapp
POSTGRES_USER=suratapp
# Gunakan nilai acak URL-safe karena password dipakai di DATABASE_URL.
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE_URL_SAFE

# Minimal 32 byte acak. Contoh pembuatan: openssl rand -hex 48
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_YANG_PANJANG
JWT_EXPIRES_IN=8h

# Hanya dipakai saat membuat data awal secara manual. Jangan gunakan contoh ini.
INITIAL_ACCOUNT_PASSWORD=GANTI_DENGAN_PASSWORD_AWAL_PEGAWAI
SEED_ACCOUNT_PASSWORD=GANTI_DENGAN_PASSWORD_AWAL_WARGA

# SMTP produksi untuk aktivasi akun dan reset kata sandi.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=GANTI_DENGAN_PASSWORD_SMTP
SMTP_FROM=SuratBatam <noreply@example.com>

# Opsional. Kosongkan jika WhatsApp belum dipakai.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
